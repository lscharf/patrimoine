# ---------------------------------------------------------------------------
# Modèle de configuration — copier vers `.env` puis remplir.
#
#   cp .env.example .env
#
# Ce fichier est le SEUL endroit où vivent les secrets : rien n'est jamais
# inscrit dans l'image Docker. Le fichier `.env` ne doit pas être versionné
# (il est déjà couvert par `.gitignore` et `.dockerignore`).
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------

# Chemin du fichier SQLite à l'intérieur du conteneur.
# Doit pointer dans /app/data, qui est le volume nommé persistant : toute autre
# valeur ferait disparaître le portefeuille à chaque recréation du conteneur.
# Les fichiers annexes du mode WAL (-wal et -shm) sont créés à côté.
PORTFOLIO_DB_PATH=/app/data/portfolio.db

# --- Authentification (better-auth) ----------------------------------------

# Clé de signature des sessions et des cookies. 32 octets aléatoires minimum.
# Générer avec :
#     openssl rand -base64 32
# Changer cette valeur invalide toutes les sessions ouvertes.
BETTER_AUTH_SECRET=

# URL publique de l'application, telle que vue par le navigateur — donc l'URL
# du reverse proxy en HTTPS, pas http://localhost:3000.
# Elle sert à construire les URL de rappel OIDC ; une valeur erronée casse la
# redirection après connexion.
# Exemple : https://patrimoine.example.com
BETTER_AUTH_URL=

# Liste blanche des adresses e-mail autorisées à se connecter, séparées par des
# virgules et sans espace. Toute autre identité authentifiée est refusée.
# Exemple : moi@example.com,conjoint@example.com
AUTH_ALLOWED_EMAILS=

# --- Fournisseur OIDC (Authelia) -------------------------------------------

# URL de base (issuer) du serveur Authelia, sans barre oblique finale.
# Doit correspondre exactement au champ `iss` des jetons émis.
# Exemple : https://auth.example.com
AUTHELIA_ISSUER=

# Identifiant du client déclaré côté Authelia, dans `identity_providers.oidc.clients`.
AUTHELIA_CLIENT_ID=patrimoine

# Secret partagé du client OIDC.
# Authelia stocke ce secret haché de son côté : la valeur en clair est déposée
# ici et nulle part ailleurs. Générer avec :
#     openssl rand -base64 32
AUTHELIA_CLIENT_SECRET=

# --- Accès API (Widgets / Plugins / CLI) ------------------------------------

# Jeton d'accès pour interroger les endpoints API (ex: plugin Omarchy bar).
# Transmis via le header `Authorization: Bearer <token>` ou `X-API-Key: <token>`.
# Générer avec :
#     openssl rand -hex 24
PATRIMOINE_API_TOKEN=

# Adresse e-mail du compte dont le portefeuille doit être restitué par l'API
# (optionnel, par défaut le premier compte existant en base).
PATRIMOINE_API_USER_EMAIL=
